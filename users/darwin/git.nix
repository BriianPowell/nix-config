# Git extras for boog (macOS): global ignores and SSH commit signing (identity: ../common/git.nix).
let
  keys = import ../../secrets/keys.nix;
in
{
  git = {
    ignores = [
      ".DS_Store"
      # Generated by graphify (the /bootstrap command in OpenCode).
      "graphify-out/"
    ];
    signing = {
      enable = true;
      key = keys.gitSigning;
    };
  };
}
